        "model = AutoModel.from_pretrained(model_name)\n",
        "\n",
        "# Đường dẫn đến file dữ liệu\n",
        "data_path = \"/content/drive/MyDrive/Colab Notebooks/GENERATED+QUIZ_SEGMENTED+VNCORE.csv\"\n",
        "data = pd.read_csv(data_path)\n",
        "\n",
        "# Kiểm tra dữ liệu, đảm bảo chứa các cột cần thiết 'question' và 'answer'\n",
        "required_columns = {'question', 'answer'}\n",
        "if not required_columns.issubset(data.columns):\n",
        "    raise ValueError(f\"Dataset CSV must contain the columns: {required_columns}\")\n",
        "\n",
        "# Xóa các hàng có giá trị null trong các cột 'question' và 'answer'\n",
        "data.dropna(subset=['question', 'answer'], inplace=True)\n",
        "\n",
        "# Thiết lập thiết bị sử dụng GPU nếu có, nếu không sẽ sử dụng CPU\n",
        "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "\n",
        "# Mô hình đã được load từ thư mục đã huấn luyện, không cần load từ checkpoint\n",
        "model.to(device)\n",
        "model.eval()  # Chuyển mô hình sang chế độ đánh giá (eval mode)\n",
        "\n",
        "# Hàm thực hiện Mean Pooling trên hidden states, sử dụng attention_mask để loại bỏ padding tokens\n",
        "def mean_pooling(hidden_states, attention_mask):\n",
        "    \"\"\"\n",
        "    Thực hiện Mean Pooling trên hidden states, loại bỏ các token padding.\n",
        "    \"\"\"\n",
        "    attention_mask_expanded = attention_mask.unsqueeze(-1).expand(hidden_states.size())\n",
        "    sum_hidden_states = torch.sum(hidden_states * attention_mask_expanded, dim=1)\n",
        "    sum_attention_mask = torch.clamp(torch.sum(attention_mask_expanded, dim=1), min=1e-9)\n",
        "    return sum_hidden_states / sum_attention_mask  # Trả về trung bình của hidden states\n",
        "\n",
        "# Hàm mã hóa câu hỏi và câu trả lời riêng biệt, sử dụng Mean Pooling để lấy embeddings\n",
        "def encode_texts(questions, answers):\n",
        "    \"\"\"\n",
        "    Mã hóa các câu hỏi và câu trả lời riêng biệt và tính toán embeddings.\n",
        "    \"\"\"\n",
        "    # Mã hóa câu hỏi và câu trả lời, sử dụng padding và truncation để đảm bảo độ dài đồng nhất\n",
        "    question_inputs = tokenizer(\n",
        "        questions, padding=True, truncation=True, max_length=256, return_tensors=\"pt\"\n",
        "    )\n",
        "    answer_inputs = tokenizer(\n",
        "        answers, padding=True, truncation=True, max_length=256, return_tensors=\"pt\"\n",
        "    )\n",
        "\n",
        "    # Chuyển các tensor vào device (GPU hoặc CPU)\n",
        "    question_input_ids = question_inputs[\"input_ids\"].to(device)\n",
        "    question_attention_mask = question_inputs[\"attention_mask\"].to(device)\n",
        "\n",
        "    answer_input_ids = answer_inputs[\"input_ids\"].to(device)\n",
        "    answer_attention_mask = answer_inputs[\"attention_mask\"].to(device)\n",
        "\n",
        "    with torch.no_grad():  # Tắt gradient calculation để tăng tốc độ\n",
        "        # Lấy output từ mô hình PhoBERT\n",
        "        question_outputs = model(question_input_ids, attention_mask=question_attention_mask, output_hidden_states=True)\n",
        "        answer_outputs = model(answer_input_ids, attention_mask=answer_attention_mask, output_hidden_states=True)\n",
        "\n",
        "        # Truy xuất hidden states từ mô hình\n",
        "        question_hidden_states = question_outputs.last_hidden_state\n",
        "        answer_hidden_states = answer_outputs.last_hidden_state\n",
        "\n",
        "        # Tính toán embeddings bằng cách thực hiện Mean Pooling\n",
        "        question_embeddings = mean_pooling(question_hidden_states, question_attention_mask)\n",
        "        answer_embeddings = mean_pooling(answer_hidden_states, answer_attention_mask)\n",
        "\n",
        "    return question_embeddings.cpu(), answer_embeddings.cpu()\n",
        "\n",
        "# Chia dữ liệu thành các batch và tính toán embeddings cho từng batch\n",
        "batch_size = 16\n",
        "question_embeddings = []\n",
        "answer_embeddings = []\n",
        "\n",
        "for i in range(0, len(data), batch_size):\n",
        "    # Lấy các câu hỏi và câu trả lời trong batch\n",
        "    batch_questions = data['question'].iloc[i:i + batch_size].tolist()\n",
        "    batch_answers = data['answer'].iloc[i:i + batch_size].tolist()\n",
        "\n",
        "    print(f\"[DEBUG] Processing Batch {i // batch_size + 1}:\")\n",
        "    print(f\"  Batch Questions: {batch_questions[:5]}...\")  # In 5 câu hỏi đầu tiên để kiểm tra\n",
        "    print(f\"  Batch Answers: {batch_answers[:5]}...\")  # In 5 câu trả lời đầu tiên để kiểm tra\n",
        "\n",
        "    # Tính toán embeddings cho câu hỏi và câu trả lời\n",
        "    question_embeds, answer_embeds = encode_texts(batch_questions, batch_answers)\n",
        "\n",
        "    # Lưu embeddings vào list\n",
        "    question_embeddings.append(question_embeds)\n",
        "    answer_embeddings.append(answer_embeds)\n",
        "\n",
        "# Kết hợp tất cả embeddings từ các batch thành một tensor duy nhất\n",
        "question_embeddings = torch.cat(question_embeddings)\n",
        "answer_embeddings = torch.cat(answer_embeddings)\n",
        "\n",
        "print(f\"[DEBUG] Combined Question Embeddings Shape: {question_embeddings.shape}\")\n",
        "print(f\"[DEBUG] Combined Answer Embeddings Shape: {answer_embeddings.shape}\")\n",
        "\n",
        "# Tính toán độ tương đồng cosine giữa các embeddings câu hỏi và câu trả lời\n",
        "cosine_similarities = F.cosine_similarity(question_embeddings, answer_embeddings)\n",
        "print(f\"[DEBUG] Cosine Similarities: {cosine_similarities[:5]}...\")  # In 5 giá trị cosine similarity đầu tiên\n",
        "\n",
        "# Lưu embeddings và độ tương đồng cosine vào file\n",
        "output_path = \"/content/drive/MyDrive/Colab Notebooks/question_answer_embeddings.pt\"\n",
        "torch.save((question_embeddings, answer_embeddings, cosine_similarities), output_path)\n",
        "print(f\"Embeddings and cosine similarities saved to {output_path}\")\n"
      ]
    },
