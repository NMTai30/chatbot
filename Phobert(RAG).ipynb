      "source": [
        "import torch\n",
        "from transformers import AutoTokenizer, AutoModel, AutoModelForCausalLM\n",
        "import pandas as pd\n",
        "import faiss\n",
        "from google.colab import drive\n",
        "import requests\n",
        "\n",
        "# Gắn Google Drive để truy cập dữ liệu\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "# Đường dẫn tới dữ liệu và mô hình\n",
        "model_name = \"/content/drive/MyDrive/Colab Notebooks/trained_phobert_kfold\"\n",
        "embedding_file_path = \"/content/drive/MyDrive/Colab Notebooks/question_answer_embeddings.pt\"\n",
        "data_path = \"/content/drive/MyDrive/Colab Notebooks/GENERATED+QUIZ_SEGMENTED+VNCORE.csv\"\n",
        "segmented_dict_path = \"/content/drive/MyDrive/Colab Notebooks/segmented_word.txt\"\n",
        "\n",
        "# API của Hugging Face\n",
        "HUGGINGFACE_API_URL = \"https://api-inference.huggingface.co/models/bigscience/bloomz-560m\"\n",
        "HUGGINGFACE_API_KEY = \"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\"  # Thay YOUR_API_KEY bằng token của bạn\n",
        "HEADERS = {\"Authorization\": f\"Bearer {HUGGINGFACE_API_KEY}\"}\n",
        "\n",
        "# Kiểm tra thiết bị\n",
        "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "print(f\"[INFO] Sử dụng thiết bị: {device}\")\n",
        "\n",
        "# Load tokenizer và mô hình PhoBERT\n",
        "print(\"[INFO] Đang tải tokenizer và mô hình PhoBERT...\")\n",
        "tokenizer = AutoTokenizer.from_pretrained(model_name)\n",
        "model = AutoModel.from_pretrained(model_name)\n",
        "model.to(device)\n",
        "model.eval()\n",
        "\n",
        "# Load dữ liệu CSV chứa cột 'question' và 'answer'\n",
        "print(\"[INFO] Đang tải dữ liệu câu hỏi và câu trả lời...\")\n",
        "data = pd.read_csv(data_path)\n",
        "required_columns = {'question', 'answer'}\n",
        "if not required_columns.issubset(data.columns):\n",
        "    raise ValueError(f\"Dataset CSV phải chứa các cột: {required_columns}\")\n",
        "data.dropna(subset=['question', 'answer'], inplace=True)\n",
        "\n",
        "# Load embeddings đã lưu\n",
        "print(\"[INFO] Đang tải embeddings từ file...\")\n",
        "try:\n",
        "    question_embeddings, answer_embeddings, _ = torch.load(embedding_file_path)\n",
        "except Exception as e:\n",
        "    raise RuntimeError(f\"Lỗi khi tải embeddings: {e}\")\n",
        "\n",
        "# Chuẩn bị chỉ số FAISS\n",
        "print(\"[INFO] Đang xây dựng FAISS index...\")\n",
        "dim = question_embeddings.shape[1]\n",
        "index = faiss.IndexFlatL2(dim)\n",
        "faiss.normalize_L2(question_embeddings.numpy())\n",
        "index.add(question_embeddings.numpy())\n",
        "print(\"[INFO] FAISS index đã được xây dựng thành công.\")\n",
        "\n",
        "# Load từ điển segmented words\n",
        "def load_segmented_words(file_path):\n",
        "    segmented_dict = {}\n",
        "    with open(file_path, 'r', encoding='utf-8') as f:\n",
        "        for line in f:\n",
        "            word = line.strip()\n",
        "            if word:\n",
        "                segmented_dict[word.replace(\"_\", \" \")] = word\n",
        "    return segmented_dict\n",
        "\n",
        "print(\"[INFO] Đang tải từ điển segmented words...\")\n",
        "segmented_dict = load_segmented_words(segmented_dict_path)\n",
        "\n",
        "# Hàm tiền xử lý câu hỏi\n",
        "def preprocess_question(question, segmented_dict):\n",
        "    question = question.lower()\n",
        "    for original, replacement in segmented_dict.items():\n",
        "        question = question.replace(original, replacement)\n",
        "    return question\n",
        "\n",
        "# Hàm tokenize câu hỏi\n",
        "def tokenize_question(question):\n",
        "    return tokenizer(question, return_tensors=\"pt\", padding=True, truncation=True, max_length=256)\n",
        "\n",
        "# Hàm lấy embedding của câu hỏi\n",
        "def get_question_embedding(tokenized_inputs):\n",
        "    tokenized_inputs = {k: v.to(device) for k, v in tokenized_inputs.items()}\n",
        "    with torch.no_grad():\n",
        "        outputs = model(**tokenized_inputs)\n",
        "    return outputs.last_hidden_state.mean(dim=1)\n",
        "\n",
        "# Hàm gọi Hugging Face API để tạo câu trả lời fallback\n",
        "def generate_answer_with_huggingface_api(question):\n",
        "    print(\"[INFO] Đang sử dụng Hugging Face API để tạo câu trả lời...\")\n",
        "    payload = {\n",
        "        \"inputs\": question,\n",
        "        \"parameters\": {\"max_length\": 100, \"num_beams\": 5, \"early_stopping\": True},\n",
        "    }\n",
        "    try:\n",
        "        response = requests.post(HUGGINGFACE_API_URL, headers=HEADERS, json=payload)\n",
        "        if response.status_code == 200:\n",
        "            # Đảm bảo phản hồi chứa dữ liệu hợp lệ\n",
        "            result = response.json()\n",
        "            if \"generated_text\" in result:\n",
        "                return result[\"generated_text\"]\n",
        "            else:\n",
        "                print(f\"[ERROR] Phản hồi API không hợp lệ: {result}\")\n",
        "                return \"Không thể tạo câu trả lời từ API.\"\n",
        "        else:\n",
        "            print(f\"[ERROR] Lỗi API: {response.status_code}, Nội dung: {response.text}\")\n",
        "            return f\"Lỗi khi gọi API: {response.status_code}\"\n",
        "    except requests.exceptions.RequestException as e:\n",
        "        print(f\"[ERROR] Lỗi kết nối API: {e}\")\n",
        "        return \"Không thể kết nối tới API Hugging Face.\"\n",
        "\n",
        "\n",
        "# Hàm tìm câu trả lời tốt nhất với fallback API\n",
        "def find_best_answer_with_fallback(question, data, tokenizer, model, index, segmented_dict, threshold=0.3):\n",
        "    try:\n",
        "        # Tiền xử lý và tokenize câu hỏi\n",
        "        preprocessed_question = preprocess_question(question, segmented_dict)\n",
        "        tokenized_inputs = tokenize_question(preprocessed_question)\n",
        "        question_embedding = get_question_embedding(tokenized_inputs).cpu().numpy()\n",
        "\n",
        "        # Tìm kiếm với FAISS\n",
        "        faiss.normalize_L2(question_embedding)\n",
        "        distances, indices = index.search(question_embedding, k=1)\n",
        "        best_match_index = indices[0][0]\n",
        "        best_distance = distances[0][0]\n",
        "\n",
        "        # Kiểm tra ngưỡng tương tự\n",
        "        if best_distance <= threshold:\n",
        "            return data.iloc[best_match_index]['answer']\n",
        "        else:\n",
        "            print(\"[INFO] Không tìm thấy câu trả lời phù hợp trong FAISS. Sử dụng Hugging Face API.\")\n",
        "            return generate_answer_with_huggingface_api(question)\n",
        "    except Exception as e:\n",
        "        print(f\"[ERROR] Đã xảy ra lỗi khi tìm câu trả lời: {e}\")\n",
        "        return \"Xin lỗi, hệ thống không thể xử lý yêu cầu của bạn vào lúc này.\"\n",
        "\n",
        "# Giao diện chính\n",
        "if __name__ == \"__main__\":\n",
        "    print(\"[INFO] Hệ thống đã sẵn sàng nhận câu hỏi.\")\n",
        "    while True:\n",
        "        user_question = input(\"Nhập câu hỏi của bạn (gõ 'exit' để thoát): \")\n",
        "        if user_question.lower() == 'exit':\n",
        "            print(\"Tạm biệt!\")\n",
        "            break\n",
        "\n",
        "        try:\n",
        "            answer = find_best_answer_with_fallback(\n",
        "                user_question,\n",
        "                data,\n",
        "                tokenizer,\n",
        "                model,\n",
        "                index,\n",
        "                segmented_dict,\n",
        "                threshold=0.3\n",
        "            )\n",
        "            print(f\"Câu trả lời: {answer}\")\n",
        "        except Exception as e:\n",
        "            print(f\"[ERROR] Đã xảy ra lỗi: {e}\")\n"
      ]
    }
