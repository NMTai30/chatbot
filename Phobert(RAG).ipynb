      "source": [
        "# dữ liệu được xử lý thành các cặp (question, answer),\n",
        "# với nhãn 1 cho các cặp đúng và nhãn 0 cho các cặp sai (ngẫu nhiên hoán đổi câu trả lời)\n",
        "import pandas as pd\n",
        "import torch\n",
        "from sklearn.model_selection import train_test_split, KFold\n",
        "from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score\n",
        "from transformers import AutoTokenizer, AutoModelForSequenceClassification, AdamW\n",
        "from torch.utils.data import DataLoader, TensorDataset\n",
        "from google.colab import drive\n",
        "\n",
        "# Gắn kết Google Drive để đọc dữ liệu\n",
        "print(\"Mounting Google Drive...\")\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "# Thiết lập thiết bị GPU nếu có\n",
        "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "print(f\"Using device: {device}\")\n",
        "\n",
        "def load_data(file_path):\n",
        "    \"\"\"\n",
        "    Đọc dữ liệu từ file CSV chứa cột 'question' và 'answer'.\n",
        "    \"\"\"\n",
        "    data = pd.read_csv(file_path, delimiter=\",\")\n",
        "    print(\"Dataset loaded successfully. Preview:\")\n",
        "    print(data.head())\n",
        "    print(data.shape)  # Số hàng và cột trong tập dữ liệu\n",
        "    print(data['question'].shape)\n",
        "    print(data['answer'].shape)\n",
        "    return data\n",
        "\n",
        "def preprocess_data(data, tokenizer, max_length=256):\n",
        "    \"\"\"\n",
        "    Tạo các cặp câu với nhãn tương ứng:\n",
        "    - label = 1: Câu hỏi và câu trả lời đúng.\n",
        "    - label = 0: Câu hỏi và câu trả lời sai (ngẫu nhiên ghép).\n",
        "\n",
        "    Tokenize dữ liệu để chuẩn bị cho mô hình.\n",
        "    \"\"\"\n",
        "    # Tạo nhãn 1 cho cặp đúng\n",
        "    positive_pairs = data.copy()\n",
        "    positive_pairs['label'] = 1\n",
        "\n",
        "    # Tạo nhãn 0 cho cặp sai bằng cách hoán vị ngẫu nhiên cột answer\n",
        "    negative_pairs = data.copy()\n",
        "    negative_pairs['answer'] = data['answer'].sample(frac=1).reset_index(drop=True)\n",
        "    negative_pairs['label'] = 0\n",
        "\n",
        "    # Kết hợp cả hai loại cặp\n",
        "    combined_data = pd.concat([positive_pairs, negative_pairs], ignore_index=True)\n",
        "\n",
        "    # Tokenize dữ liệu\n",
        "    inputs = tokenizer(\n",
        "        combined_data['question'].tolist(),\n",
        "        combined_data['answer'].tolist(),\n",
        "        max_length=max_length,\n",
        "        padding='max_length',\n",
        "        truncation=True,\n",
        "        return_tensors='pt'\n",
        "    )\n",
        "\n",
        "    labels = torch.tensor(combined_data['label'].tolist())\n",
        "\n",
        "    return inputs, labels\n",
        "\n",
        "def create_dataloader(inputs, labels, batch_size=16):\n",
        "    \"\"\"\n",
        "    Chuyển đổi dữ liệu thành DataLoader để huấn luyện mô hình.\n",
        "    \"\"\"\n",
        "    dataset = TensorDataset(\n",
        "        inputs['input_ids'],\n",
        "        inputs['attention_mask'],\n",
        "        labels\n",
        "    )\n",
        "    return DataLoader(dataset, batch_size=batch_size, shuffle=True)\n",
        "\n",
        "def train_model(model, train_loader, learning_rate=1e-5, epochs=3):\n",
        "    \"\"\"\n",
        "    Huấn luyện mô hình với AdamW optimizer và CrossEntropyLoss.\n",
        "    \"\"\"\n",
        "    model.to(device)\n",
        "    optimizer = AdamW(model.parameters(), lr=learning_rate)\n",
        "    model.train()\n",
        "\n",
        "    for epoch in range(epochs):\n",
        "        total_loss = 0\n",
        "        for batch in train_loader:\n",
        "            input_ids, attention_mask, labels = [item.to(device) for item in batch]\n",
        "            optimizer.zero_grad()\n",
        "\n",
        "            # Forward pass\n",
        "            outputs = model(input_ids=input_ids, attention_mask=attention_mask, labels=labels)\n",
        "            loss = outputs.loss\n",
        "\n",
        "            # Backward pass\n",
        "            total_loss += loss.item()\n",
        "            loss.backward()\n",
        "            optimizer.step()\n",
        "\n",
        "        print(f\"Epoch {epoch + 1}/{epochs}, Loss: {total_loss / len(train_loader):.4f}\")\n",
        "\n",
        "    return model\n",
        "\n",
        "def evaluate_model(model, val_loader):\n",
        "    \"\"\"\n",
        "    Đánh giá mô hình trên tập validation.\n",
        "    \"\"\"\n",
        "    model.eval()\n",
        "    preds, true_labels = [], []\n",
        "\n",
        "    with torch.no_grad():\n",
        "        for batch in val_loader:\n",
        "            input_ids, attention_mask, labels = [item.to(device) for item in batch]\n",
        "\n",
        "            outputs = model(input_ids=input_ids, attention_mask=attention_mask)\n",
        "            logits = outputs.logits\n",
        "            preds.extend(torch.argmax(logits, axis=1).cpu().numpy())\n",
        "            true_labels.extend(labels.cpu().numpy())\n",
        "\n",
        "    # Tính các chỉ số đánh giá\n",
        "    accuracy = accuracy_score(true_labels, preds)\n",
        "    precision = precision_score(true_labels, preds)\n",
        "    recall = recall_score(true_labels, preds)\n",
        "    f1 = f1_score(true_labels, preds)\n",
        "\n",
        "    print(\"Evaluation Results:\")\n",
        "    print(f\"Accuracy: {accuracy:.4f}\")\n",
        "    print(f\"Precision: {precision:.4f}\")\n",
        "    print(f\"Recall: {recall:.4f}\")\n",
        "    print(f\"F1 Score: {f1:.4f}\")\n",
        "\n",
        "def main():\n",
        "    # Đường dẫn đến file CSV trên Google Drive\n",
        "    file_path = \"/content/drive/MyDrive/Colab Notebooks/GENERATED+QUIZ_SEGMENTED+VNCORE.csv\"\n",
        "\n",
        "    # Load tokenizer và model từ PhoBERT\n",
        "    tokenizer = AutoTokenizer.from_pretrained(\"vinai/phobert-base-v2\")\n",
        "    model = AutoModelForSequenceClassification.from_pretrained(\"vinai/phobert-base-v2\", num_labels=2)\n",
        "\n",
        "    # Bước 1: Load và preprocess dữ liệu\n",
        "    print(\"Loading and preprocessing data...\")\n",
        "    data = load_data(file_path)\n",
        "    inputs, labels = preprocess_data(data, tokenizer)\n",
        "\n",
        "    # KFold cross-validation (3 folds)\n",
        "    kfold = KFold(n_splits=3, shuffle=True, random_state=42)\n",
        "\n",
        "    fold_results = []\n",
        "\n",
        "    for fold, (train_idx, val_idx) in enumerate(kfold.split(inputs['input_ids'], labels)):\n",
        "        print(f\"Training fold {fold + 1}...\")\n",
        "\n",
        "        # Chia dữ liệu thành train và validation theo fold\n",
        "        train_inputs = {key: value[train_idx] for key, value in inputs.items()}\n",
        "        val_inputs = {key: value[val_idx] for key, value in inputs.items()}\n",
        "        train_labels, val_labels = labels[train_idx], labels[val_idx]\n",
        "\n",
        "        # Tạo DataLoader cho train và validation\n",
        "        train_loader = create_dataloader(train_inputs, train_labels)\n",
        "        val_loader = create_dataloader(val_inputs, val_labels)\n",
        "\n",
        "        # Huấn luyện mô hình\n",
        "        trained_model = train_model(model, train_loader)\n",
        "\n",
        "        # Đánh giá mô hình\n",
        "        print(f\"Evaluating fold {fold + 1}...\")\n",
        "        evaluate_model(trained_model, val_loader)\n",
        "\n",
        "        # Lưu kết quả của mỗi fold\n",
        "        fold_results.append({\n",
        "            \"fold\": fold + 1,\n",
        "            \"model\": trained_model\n",
        "        })\n",
        "\n",
        "    # Kết quả tổng hợp từ tất cả các fold\n",
        "    print(\"KFold cross-validation completed.\")\n",
        "\n",
        "    # Lưu mô hình và tokenizer sau khi cross-validation\n",
        "    print(\"Saving model and tokenizer...\")\n",
        "    trained_model.save_pretrained(\"/content/drive/MyDrive/Colab Notebooks/trained_phobert_kfold\")\n",
        "    tokenizer.save_pretrained(\"/content/drive/MyDrive/Colab Notebooks/trained_phobert_kfold\")\n",
        "    print(\"Model and tokenizer saved successfully.\")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
